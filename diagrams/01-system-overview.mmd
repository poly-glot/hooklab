flowchart TB
    subgraph Hosting["Firebase Hosting"]
        SPA["React SPA\n(Vite build)"]
    end

    subgraph CloudRun["Cloud Run"]
        direction TB
        Deno["Deno + Hono"]
        API["/api/*\nAuth, Endpoints"]
        Webhook["/w/*\nWebhook Receiver"]
        Sandbox["Sandbox Worker\n(script execution)"]
        Deno --- API
        Deno --- Webhook
        Webhook --> Sandbox
    end

    subgraph Firebase["Firebase Services"]
        direction TB
        Auth["Firebase Auth\n(Google, Anonymous)"]
        Firestore["Cloud Firestore\n(endpoints, users, executions)"]
        Functions["Cloud Functions\n(seed, cleanup)"]
    end

    subgraph GCP["GCP Services"]
        direction TB
        BigQuery["BigQuery\n(execution analytics)"]
        Gemini["Vertex AI / Gemini\n(SQL generation)"]
    end

    SPA -->|"rewrites /api/**, /w/**"| Deno
    SPA --> Auth
    SPA --> Firestore
    API --> Firestore
    Webhook --> Firestore
    Functions --> Firestore
    API --> BigQuery
    API --> Gemini

